rules_version = '2';

// Reglas de seguridad del ERP: publícalas en Firebase Console → Firestore → Reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email == 'sneyder.c.f@gmail.com';
    }

    function hasActiveAssignment() {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/userAccess/$(request.auth.token.email))
        && get(/databases/$(database)/documents/userAccess/$(request.auth.token.email)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/userAccess/$(request.auth.token.email)).data.active == true;
    }

    function isAdmin() {
      return hasActiveAssignment()
        && get(/databases/$(database)/documents/userAccess/$(request.auth.token.email)).data.roleId == 'admin';
    }

    // Perfiles: el usuario lee el suyo; el administrador gestiona el directorio.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Solo el administrador configurado puede crear el acceso inicial.
    match /userAccess/{email} {
      allow get: if signedIn()
        && ((request.auth.token.email is string && request.auth.token.email == email) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (isBootstrapAdmin()
          && request.auth.token.email == email
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.roleId == 'admin'
          && request.resource.data.active == true);
      allow update, delete: if isAdmin();
    }

    match /accessRoles/{roleId} {
      allow get: if isAdmin()
        || isBootstrapAdmin()
        || (hasActiveAssignment()
          && get(/databases/$(database)/documents/userAccess/$(request.auth.token.email)).data.roleId == roleId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (isBootstrapAdmin() && roleId in ['admin', 'cashier', 'warehouse', 'accountant', 'viewer']);
      allow update, delete: if isAdmin();
    }

    // Invitaciones: el usuario invitado puede leer la suya al registrarse.
    match /invites/{email} {
      allow get: if signedIn();
      allow list, create, update, delete: if isAdmin();
    }

    // Datos del ERP sincronizados desde los dispositivos (productos, clientes, proveedores).
    // Cualquier usuario autenticado del ERP puede leerlos y escribirlos; solo un
    // administrador puede borrar documentos definitivamente (las bajas normales
    // se marcan con deleted = true para que se propaguen a los demás dispositivos).
    match /erp/{company}/{collection}/{docId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }
  }
}
